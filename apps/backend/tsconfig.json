{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@afiyet/shared": ["../../packages/shared/src/index.ts"],
      "@afiyet/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
